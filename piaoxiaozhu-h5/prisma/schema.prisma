generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  avatarUrl        String?
  planCode         String   @default("free")
  quotaTotal       Int      @default(10)
  quotaUsed        Int      @default(0)
  stripeCustomerId String?
  projects         Project[]
  records          Record[]
  upgradeRequests  PlanUpgradeRequest[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  name          String
  industry      String    @default("restaurant")
  aiAnalysis    String?
  aiAnalysisAt  DateTime?
  deletedAt     DateTime?
  records       Record[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("projects")
}

model Record {
  id                String   @id @default(cuid())
  projectId         String
  userId            String
  direction         String   @default("out")
  merchantName      String?
  amount            Decimal  @db.Decimal(12, 2)
  taxAmount         Decimal?  @db.Decimal(12, 2)
  amountWithoutTax  Decimal?  @db.Decimal(12, 2)
  taxRate           Float?
  invoiceDate       String?
  invoiceType       String?
  invoiceNo         String?
  invoiceCode       String?
  checkCode         String?
  buyerName         String?
  buyerTaxNo        String?
  sellerTaxNo       String?
  items             String?
  categoryCode      String   @default("other")
  categoryL1        String   @default("其他")
  categoryL2        String?
  confidence        Float    @default(0.5)
  reason            String?
  isManualCorrected Boolean  @default(false)
  rawText           String?
  imageUrl          String?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId, invoiceDate])
  @@index([userId])
  @@index([categoryCode])
  @@map("records")
}

model PlanUpgradeRequest {
  id          String   @id @default(cuid())
  userId      String
  planCode    String   // pro / enterprise
  payMethod   String   // wechat / alipay
  status      String   @default("pending") // pending / approved / rejected
  reviewNote  String?  // 管理员审核备注
  reviewedAt  DateTime?
  reviewedBy  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("plan_upgrade_requests")
}

model Plan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  price      Float
  quotaLimit Int
  duration   Int
  features   String
  createdAt  DateTime @default(now())

  @@map("plans")
}
