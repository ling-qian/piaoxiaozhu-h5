# 票小助 Pro · 微信云托管环境变量清单（模板）
#
# 用法：在云托管控制台 → 服务 → 部署/配置 → 环境变量 里逐条填入。
# 不要把这个文件里的示例值直接用于生产。
#
# 两个服务的环境变量是**分别配置**的：api 与 worker 各填一份，
# 标了 [两者] 的两个服务都要填，标了 [仅 api] / [仅 worker] 的只填对应服务。
#
# =====================================================================
# 一、必填（不填服务起不来或功能不可用）
# =====================================================================

# [两者] 运行环境。production 会开启启动体检的强校验（配置有问题直接拒绝启动）
APP_ENV=production

# [两者] 数据库：Neon（PostgreSQL），生产用 Pooled 连接串。
# 驱动前缀必须是 postgresql+asyncpg://（不是 postgresql://）
# 连接串里主机名要带 -pooler；Region 选 Singapore（ap-southeast-1），别选美国。
# 免费版 5 分钟无访问会挂起，下次请求自动唤醒（约 1–2 秒），不影响正确性。
# 备选：腾讯云 PostgreSQL（同 VPC，延迟最低、数据在境内；上线后建议切回）
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require

# [两者] Redis（Celery 的 broker 与结果后端）
REDIS_URL=redis://:<密码>@<redis内网地址>:6379/0

# [两者] JWT 签名密钥。必须替换，且不能用示例值——启动体检会直接拒绝默认值。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<请替换为随机串>

# [两者] 微信小程序凭据（登录、手机号、内容安全都要用）
WX_APPID=<小程序 AppID>
WX_SECRET=<小程序 AppSecret>

# [仅 worker] 大模型：票据分类置信度不足时的后处理。不填则分类会降级、OCR 结果不完整。
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=<你的 LLM Key>
# ⚠️ 必须是当前在售的模型名。写已下线的旧值（agnes-2.0-flash）不会报错，
# 而是分类静默降级——票据照样入库，但分类永远是「其他」，很难发现。
LLM_MODEL_NAME=agnes-3.0-flash

# =====================================================================
# 二、对象存储（生产必填，二选一）
# =====================================================================
# APP_ENV=production 时若两项都没配，启动体检会拒绝启动：图片落容器本地盘，
# 重启即丢，缴费用户的历史票据与报表会全部失效。本地开发可不配（落本地盘）。

# 方案 A：腾讯云 COS（与云托管同厂商，可走内网免流量费，推荐）
# 配了 COS_* 就优先走 COS
COS_SECRET_ID=<腾讯云 SecretId>
COS_SECRET_KEY=<腾讯云 SecretKey>
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=<形如 piaoxiaozhu-1250000000>

# 方案 B：继续用阿里云 OSS（原方案，无需改代码）
# OSS_ACCESS_KEY_ID=<阿里云 AccessKeyId>
# OSS_ACCESS_KEY_SECRET=<阿里云 AccessKeySecret>
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET_NAME=piaoxiaozhu

# =====================================================================
# 三、微信支付（小程序端 PAYMENT_ENABLED=true，配齐下面 7 项即开通真实收款）
# =====================================================================
#
# 缺任意一项时，下单接口返回 503「支付功能暂未开放」，用户不会看到可点的升级按钮。
# 配齐后必须保持 PAYMENT_MOCK_ENABLED=false —— 开启后未付款也能零成本升级到付费套餐。
#
# 【注入方式】WX_PRIVATE_KEY_PATH / WX_PLATFORM_CERT_PATH 既接受「文件路径」，
# 也接受「PEM 内容本身」（代码里判断是否含 "-----BEGIN"）。
#   - 云托管（推荐）：直接粘贴 PEM 全文（含 -----BEGIN ... END 行）。
#   - 本地 compose / 服务器：把文件放进一个目录并挂载，然后填容器内路径，
#     例如挂载 ./certs 到 /app/certs 后填 /app/certs/apiclient_key.pem。
# 注意：镜像构建时 .dockerignore 已排除 *.pem，证书不会被烘进镜像，
# 必须靠环境变量或挂载注入，否则容器里根本没有该文件，回调验签会失败。

WX_MCH_ID=<商户号 mchid>
# APIv3 密钥：商户平台「账户中心 → API 安全」自行设置的 32 位字符串。
# 长度必须正好 32 字节，启动体检会直接加载校验，长度不对会拒绝服务。
WX_API_KEY=<32 位 APIv3 密钥>
# 商户证书序列号：商户平台「API 证书」里那本证书的「序列号」字段。
WX_CERT_SERIAL_NO=<商户证书序列号>
# 商户私钥：申请 API 证书时下载的 apiclient_key.pem（只下载一次，务必留存）。
# 填 PEM 全文，或填容器内路径（见上方【注入方式】）。
WX_PRIVATE_KEY_PATH=<apiclient_key.pem 的 PEM 全文或容器内路径>
# 微信支付平台证书：用于回调验签。用微信官方「证书工具」下载，非商户证书。
WX_PLATFORM_CERT_PATH=<平台证书的 PEM 全文或容器内路径>
# 支付结果回调地址：必须是公网 HTTPS 且不带查询参数，且已配进商户平台。
WX_NOTIFY_URL=https://<你的已备案域名>/api/payments/wechat/notify

# 必须保持 false：开启后未配置支付也能零成本开通套餐
PAYMENT_MOCK_ENABLED=false

# =====================================================================
# 四、按需调整（有合理默认值，一般不填）
# =====================================================================

# [仅 api] 监听端口。若云托管「服务端口」配成 80，平台会注入 PORT=80，这里不用管。
# PORT=8000

# [仅 api] uvicorn 进程数。容器按副本扩容，单容器 1 个进程即可。
# UVICORN_WORKERS=1

# [仅 api] 是否在启动时执行 alembic upgrade head。
# 多副本并发启动会抢迁移锁，建议只在首次部署或改表时临时置 true。
# RUN_MIGRATIONS=false

# [仅 worker] Celery 并发与单进程任务上限。PaddleOCR 吃内存，默认 1 最稳。
# CELERY_CONCURRENCY=1
# CELERY_MAX_TASKS_PER_CHILD=20
# CELERY_LOGLEVEL=info

# [两者] 上传文件落盘目录（配了对象存储时该目录只作缓存）
# UPLOAD_DIR=./uploads

# [仅 api] 内容安全（微信 imgSecCheck / msgSecCheck）。提审要求项，生产应保持 true。
# CONTENT_SECURITY_ENABLED=true

# [api + worker] 套餐到期提醒的订阅消息模板 id（微信公众平台「订阅消息」申请后填入）。
# 留空则不发提醒，只记日志。模板 keyword 名须与 wx_subscribe.build_reminder_data 一致。
# WX_SUBSCRIBE_TEMPLATE_EXPIRE=

# [仅 api] 允许的跨域来源，逗号分隔。默认 * ；小程序请求不走 CORS，此项只影响浏览器端。
# CORS_ALLOW_ORIGINS=*

# [仅 api] 报表分享链接的对外域名。H5 分享页未部署前保持默认即可（小程序内已隐藏该入口）。
SHARE_BASE_URL=https://<已部署的 H5 域名>

# [仅 api] 仅本地联调可开，生产必须 false —— 否则任何人用 code="dev_任意值" 就能绕过微信登录。
ALLOW_DEV_LOGIN=false

# =====================================================================
# 四、管理后台（可选，但建议）
# =====================================================================
# [仅 api] 管理后台令牌。留空则 /api/admin/* 全部返回 403（默认关闭，安全）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 访问：https://<服务域名>/admin ，粘贴该令牌登录。
ADMIN_TOKEN=<请替换为随机串>
