# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"

# Auth
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_URL="http://localhost:3000"

# LLM (NVIDIA API)
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_API_KEY=""
LLM_MODEL_NAME="stepfun-ai/step-3.5-flash"

# Blob Storage
BLOB_READ_WRITE_TOKEN=""

# ── 后端（Cloudflare Worker）──
# 部署 Worker 后把它的地址填这里，例如 https://piaoxiaozhu-api.<你的子域>.workers.dev
WORKER_API_URL=

# 站点地区：cn 或 intl。intl 会隐藏中国增值税专有字段、关闭每日签到
NEXT_PUBLIC_REGION=intl
# 显示币种：CNY 或 USD
NEXT_PUBLIC_CURRENCY=USD

# ── 注册安全：人机验证（Cloudflare Turnstile）──
# 在 Cloudflare 后台 → Turnstile → Add site，站点填 sortreceipts.qianling-tech.top
# 这里填 Site Key（公开的），Secret Key 放后端 Worker：
#   npx wrangler secret put TURNSTILE_SECRET_KEY --name piaoxiaozhu-api
# 这个值是构建期写进页面的，改完要重新 cf:build 才会生效。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── 访问统计（Cloudflare Web Analytics）──
# Cloudflare 后台 → Web Analytics → 添加站点 sortreceipts.qianling-tech.top，
# 复制生成的令牌填这里。这个值是构建期写进页面的，改完要重新 cf:build。
# 留空时页面不加载统计脚本。
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
