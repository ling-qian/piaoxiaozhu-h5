# Database
# 本地开发：本机 PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/piaoxiaozhu
# 生产（Neon）：必须用 **Pooled** 连接串，并在主机名里保留 -pooler
#   postgresql+asyncpg://<user>:<pass>@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
# 注意：Neon 的 pooler 是 PgBouncer（transaction 模式），不支持服务端预编译语句；
# app/models/database.py 检测到 neon.tech 会自动关闭 asyncpg 的 statement cache。

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-random-string

# WeChat Mini Program
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

# 仅本地联调：允许 "dev_" 前缀假登录码，并允许微信凭据缺失时放行登录。
# 生产必须为 false，否则任何人可用 code="dev_任意值" 绕过微信校验拿到 token。
ALLOW_DEV_LOGIN=false

# WeChat Pay (V3)
WX_MCH_ID=your-merchant-id
WX_API_KEY=your-apiv3-key-must-be-32-bytes
WX_CERT_SERIAL_NO=your-merchant-cert-serial-no
WX_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WX_PLATFORM_CERT_PATH=/app/certs/wechatpay_platform_cert.pem
WX_NOTIFY_URL=https://your-domain.com/api/payments/wechat/notify

# 仅本地联调：开启后未配置微信支付也能免支付开通套餐。生产必须为 false。
PAYMENT_MOCK_ENABLED=false

# 报表分享链接的对外域名
SHARE_BASE_URL=https://your-domain.com

# Aliyun OSS
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=piaoxiaozhu

# Tencent COS（配了就走 COS，优先于 OSS；生产必须配 COS_* 或 OSS_* 之一）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=piaoxiaozhu-1250000000

# LLM
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=agnes-3.0-flash
