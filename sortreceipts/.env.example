# ── 后端（Cloudflare Worker）──
# 所有数据请求都转到这个地址；前端不直连数据库。
# 例：https://api.qianling-tech.top
WORKER_API_URL=

# ── 站点形态 ──
# cn 或 intl。intl 会隐藏中国增值税专有字段、关闭每日签到与人工审核支付
NEXT_PUBLIC_REGION=intl
# 标价显示币种：CNY 或 USD
NEXT_PUBLIC_CURRENCY=USD
# 站点根地址。用于 canonical、sitemap、OG 图的绝对地址，构建期写入
NEXT_PUBLIC_BASE_URL=https://sortreceipts.qianling-tech.top

# ── 注册安全：人机验证（Cloudflare Turnstile）──
# Cloudflare 后台 → Turnstile → Add site，站点填 sortreceipts.qianling-tech.top
# 这里填 Site Key（公开的），Secret Key 放后端 Worker：
#   npx wrangler secret put TURNSTILE_SECRET_KEY --name piaoxiaozhu-api
# 这个值是构建期写进页面的，改完要重新 cf:build 才会生效。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── 访问统计（Cloudflare Web Analytics）──
# Cloudflare 后台 → Web Analytics → 添加站点，复制生成的令牌填这里。
# 留空时页面不加载统计脚本。
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ── 国内形态的收款码（海外部署不用）──
WECHAT_PAY_QR_URL=
ALIPAY_QR_URL=
# 仅用于判断国内形态要不要显示 Stripe 入口；实际下单由 Worker 处理
STRIPE_SECRET_KEY=
